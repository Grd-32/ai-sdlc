{
  "name": "@ai-sdlc/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./webhooks": {
      "types": "./src/webhooks.ts",
      "import": "./src/webhooks.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdlc/billing": "workspace:*",
    "@ai-sdlc/db": "workspace:*",
    "@ai-sdlc/github": "workspace:*",
    "@ai-sdlc/policy": "workspace:*",
    "@ai-sdlc/provenance": "workspace:*",
    "@ai-sdlc/source-control": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "@node-saml/node-saml": "^5.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "bullmq": "^5.34.3",
    "hono": "^4.6.14",
    "ioredis": "^5.4.2",
    "openid-client": "^6.8.8",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
