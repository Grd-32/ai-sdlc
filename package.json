{
  "name": "ai-sdlc",
  "private": true,
  "version": "0.1.0",
  "description": "AI-SDLC Control Plane — vendor-neutral security and governance for AI-assisted software development",
  "scripts": {
    "build": "node ./scripts/run-with-env.mjs pnpm -r build",
    "dev": "node ./scripts/run-with-env.mjs pnpm --parallel -r dev",
    "dev:web": "node ./scripts/run-with-env.mjs pnpm --filter @ai-sdlc/web dev",
    "dev:api": "node ./scripts/run-with-env.mjs pnpm --filter @ai-sdlc/api dev",
    "dev:worker": "node ./scripts/run-with-env.mjs pnpm --filter @ai-sdlc/worker dev",
    "lint": "node ./scripts/run-with-env.mjs pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "node ./scripts/run-with-env.mjs pnpm --filter @ai-sdlc/db generate",
    "typecheck": "node ./scripts/run-with-env.mjs pnpm -r typecheck",
    "test": "node ./scripts/run-with-env.mjs pnpm -r test",
    "db:generate": "node ./scripts/run-with-env.mjs pnpm --filter @ai-sdlc/db generate",
    "db:migrate": "node ./scripts/run-with-env.mjs pnpm --filter @ai-sdlc/db migrate",
    "db:push": "node ./scripts/run-with-env.mjs pnpm --filter @ai-sdlc/db push",
    "db:backup": "node ./scripts/db-backup.mjs",
    "db:restore": "node ./scripts/db-restore.mjs",
    "audit:verify": "pnpm --filter @ai-sdlc/api exec tsx ../../scripts/verify-audit-export.ts",
    "load:test": "node ./scripts/load-test.mjs",
    "security:review": "node ./scripts/security-review-checklist.mjs",
    "clean": "node ./scripts/run-with-env.mjs pnpm -r clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
