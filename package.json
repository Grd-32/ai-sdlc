{
  "name": "ai-sdlc",
  "private": true,
  "version": "0.1.0",
  "description": "AI-SDLC Control Plane — vendor-neutral security and governance for AI-assisted software development",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --parallel -r dev",
    "dev:web": "pnpm --filter @ai-sdlc/web dev",
    "dev:api": "pnpm --filter @ai-sdlc/api dev",
    "dev:worker": "pnpm --filter @ai-sdlc/worker dev",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @ai-sdlc/db generate",
    "db:migrate": "pnpm --filter @ai-sdlc/db migrate",
    "db:push": "pnpm --filter @ai-sdlc/db push",
    "clean": "pnpm -r clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
