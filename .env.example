# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GITHUB_APP_SLUG=

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://ai_sdlc:ai_sdlc_dev@localhost:5432/ai_sdlc?schema=public

# Compose connection uses the Docker-network hostname; keep database and
# credentials aligned with DATABASE_URL when overriding either URL.
COMPOSE_DATABASE_URL=postgresql://ai_sdlc:ai_sdlc_dev@postgres:5432/ai_sdlc?schema=public

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── GitHub App (Phase 2+) ─────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_BASE_URL=https://api.github.com

# ─── Session / Auth (Phase 1+) ─────────────────────────────────
# SESSION_SECRET=change-me-to-a-random-32-byte-secret

# ─── Ports (Docker Compose overrides) ──────────────────────────
# WEB_PORT=3000
# API_PORT=3001

SESSION_SECRET=ai_sdlc_dev_secret
GITHUB_APP_CALLBACK_URL=http://localhost:3001/api/auth/github/callback
