# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000
# Comma-separated authenticated user IDs authorized to approve irreversible
# organization deletion requests. Leave empty to disable approvals.
DATA_DELETION_OPERATOR_USER_IDS=
NGROK_DOMAIN=
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Optional canonical host; leave blank to inherit APP_URL.
NEXT_PUBLIC_SITE_URL=
# Optional Google Analytics 4 measurement ID. Analytics load only after explicit consent.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Contact enquiries are forwarded server-side to an operator-managed HTTPS
# endpoint. Keep this bearer token in the server environment only.
# CONTACT_WEBHOOK_URL=
# CONTACT_WEBHOOK_TOKEN=

# Optional transactional email for review/finding assignments.
# Email remains in-app only when RESEND_API_KEY is not configured.
# RESEND_API_KEY=re_...
# For local tests, use a Resend-provided test sender only if permitted by your account;
# otherwise verify a domain you control before setting EMAIL_FROM.
# EMAIL_FROM=onboarding@resend.dev

# Optional offer descriptions shown on the public pricing page.
# NEXT_PUBLIC_PROFESSIONAL_OFFER=
# NEXT_PUBLIC_ENTERPRISE_OFFER=

# ─── Commercial plans and billing ─────────────────────────────
# These values are server-side configuration. Never prefix Stripe secrets with NEXT_PUBLIC_.
PLAN_FREE_NAME=Free Assessment
PLAN_FREE_DESCRIPTION=A scoped repository risk assessment; continuous monitoring is not included.
PLAN_FREE_DISPLAY_PRICE=Free
FREE_MAX_REPOSITORIES=10
FREE_ASSESSMENTS_PER_MONTH=1
FREE_RETENTION_DAYS=90
FREE_MAX_TEAM_MEMBERS=5

PLAN_PROFESSIONAL_NAME=Professional
PLAN_PROFESSIONAL_DESCRIPTION=Continuous security and governance for growing engineering teams.
PLAN_PROFESSIONAL_DISPLAY_PRICE=Contact for pricing
PLAN_PROFESSIONAL_INTERVAL=month
PROFESSIONAL_MAX_REPOSITORIES=25
PROFESSIONAL_ASSESSMENTS_PER_MONTH=10
PROFESSIONAL_ANALYSIS_JOBS_PER_MONTH=1000
PROFESSIONAL_RETENTION_DAYS=90
PROFESSIONAL_MAX_TEAM_MEMBERS=25

PLAN_ENTERPRISE_NAME=Enterprise
PLAN_ENTERPRISE_DISPLAY_PRICE=Custom agreement
ENTERPRISE_DEFAULT_MAX_REPOSITORIES=100
ENTERPRISE_DEFAULT_ASSESSMENTS_PER_MONTH=100
ENTERPRISE_DEFAULT_ANALYSIS_JOBS_PER_MONTH=10000
ENTERPRISE_DEFAULT_RETENTION_DAYS=365
ENTERPRISE_DEFAULT_MAX_TEAM_MEMBERS=100

# Configure a Stripe test-mode Price ID before enabling Professional self-service checkout.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PROFESSIONAL=price_...
# BILLING_ADMIN_USER_IDS=server-provisioned-operator-user-id

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://ai_sdlc:ai_sdlc_dev@localhost:5432/ai_sdlc?schema=public

# Compose connection uses the Docker-network hostname; keep database and
# credentials aligned with DATABASE_URL when overriding either URL.
COMPOSE_DATABASE_URL=postgresql://ai_sdlc:ai_sdlc_dev@postgres:5432/ai_sdlc?schema=public

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── GitHub App (Phase 2+) ─────────────────────────────────────
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_WEBHOOK_SECRET=
GITHUB_APP_BASE_URL=https://api.github.com

# Sessions are opaque, random, and stored in PostgreSQL; runtime does not use SESSION_SECRET.

# ─── Ports (Docker Compose overrides) ──────────────────────────
# WEB_PORT=3000
# API_PORT=3001

GITHUB_APP_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# ─── GitLab.com OAuth (read-only provider foundation) ──────────
# Register this exact callback URL in a GitLab.com OAuth application.
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/gitlab/callback
# Generate once with: openssl rand -base64 32
# Keep identical across API restarts and backups; changing it makes saved tokens unreadable.
SOURCE_CONTROL_ENCRYPTION_KEY=

# ─── Enterprise SSO ─────────────────────────────────────────────
# Generate once with: openssl rand -base64 32
# Keep independent from SOURCE_CONTROL_ENCRYPTION_KEY and back it up securely.
SSO_ENCRYPTION_KEY=
# Comma-separated exact HTTPS issuer URLs approved for tenant-configured OIDC.
# This allowlist constrains discovery/token/JWKS requests to prevent SSRF.
SSO_OIDC_ALLOWED_ISSUERS=

# Optional bearer token for the internal, platform-wide queue operations endpoint.
# Generate with: openssl rand -base64 32
# Never expose this value to browser code or organization users.
QUEUE_OPERATIONS_TOKEN=

# ─── Bitbucket Cloud OAuth (optional; server-only) ─────────────
# Register these exact callback URLs in the provider applications.
BITBUCKET_OAUTH_CLIENT_ID=
BITBUCKET_OAUTH_CLIENT_SECRET=
BITBUCKET_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/bitbucket/callback

# ─── Azure DevOps via Microsoft Entra (optional; server-only) ─
# Register the callback in the Entra app; AZURE_DEVOPS_TENANT_ID may be a tenant GUID.
AZURE_DEVOPS_OAUTH_CLIENT_ID=
AZURE_DEVOPS_OAUTH_CLIENT_SECRET=
AZURE_DEVOPS_OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/azure-devops/callback
AZURE_DEVOPS_TENANT_ID=organizations
