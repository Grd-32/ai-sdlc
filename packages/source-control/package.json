{
  "name": "@ai-sdlc/source-control",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./gitlab": {
      "types": "./src/gitlab.ts",
      "import": "./dist/gitlab.js"
    },
    "./gitlab-oauth": {
      "types": "./src/gitlab-oauth.ts",
      "import": "./dist/gitlab-oauth.js"
    },
    "./bitbucket": {
      "types": "./src/bitbucket.ts",
      "import": "./dist/bitbucket.js"
    },
    "./azure-devops": {
      "types": "./src/azure-devops.ts",
      "import": "./dist/azure-devops.js"
    },
    "./bitbucket-oauth": {
      "types": "./src/bitbucket-oauth.ts",
      "import": "./dist/bitbucket-oauth.js"
    },
    "./azure-devops-oauth": {
      "types": "./src/azure-devops-oauth.ts",
      "import": "./dist/azure-devops-oauth.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
